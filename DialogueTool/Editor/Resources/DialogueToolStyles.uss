.grid-background {
    background-color: rgb(43, 43, 43);
}

.thick-line {
    stroke-width: 2px;
}

.dialogue-node {
    position: absolute;
    background-color: rgb(56, 56, 56);
    border-color: rgb(26, 26, 26);
    border-width: 1px;
    border-radius: 8px;
    width: 300px;
    height: auto;
    min-height: 80px;
    padding: 8px;
    justify-content: space-between;
}

.dialogue-node:hover {
    border-color: rgb(212, 212, 212);
}

.dialogue-node.selected {
    border-color: rgb(68, 170, 255);
    border-width: 2px;
}

.node-title {
    -unity-font-style: bold;
    color: rgb(238, 238, 238);
    margin-bottom: 8px;
    background-color: rgb(34, 34, 34);
    padding: 4px;
    border-radius: 4px;
}

.port {
    width: 24px;
    height: 24px;
    background-color: rgb(34, 34, 34);
    border-radius: 12px;
    border-width: 2px;
    border-color: rgb(136, 136, 136);
    align-self: center;
    margin: 4px;
}

.port.input {
    background-color: rgb(255, 255, 255);
}

.port.output {
    background-color: rgb(0, 0, 0);
}

.port-container {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
}

.unity-label {
    color: rgb(255, 255, 255);
}

.body-container {
    background-color: rgb(75, 75, 75);
}
